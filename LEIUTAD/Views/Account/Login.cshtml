@model LEIUTAD.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #f8f9fa;">
    <div class="container mt-5" style="max-width: 400px;">
        <h1 class="text-center mb-4">Login</h1>

        <!-- Mensagens de erro globais -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-center">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post" class="p-4 border rounded shadow-sm bg-white">
            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Digite o seu email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Digite a sua password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Lembrar-me -->
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="rememberMe" />
                <label class="form-check-label" for="rememberMe" style="color: #6c757d;">Lembrar-me</label>
            </div>

            <!-- Botão de Login -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </div>
        </form>

        <!-- Link para Registo -->
        <div class="text-center mt-4">
            <p style="color: #6c757d;">Ainda não tem conta? <a asp-action="Register" asp-controller="Account" style="text-decoration: none; color: #007bff; font-weight: bold;">Registar-se</a></p>
        </div>
    </div>

    <!-- Espaço extra para evitar que o botão toque no footer -->
    <div style="margin-bottom: 100px;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

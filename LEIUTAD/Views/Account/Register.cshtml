@model LEIUTAD.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Registo";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #f8f9fa;">
    <div class="container mt-5" style="max-width: 400px;">
        <h1 class="text-center mb-4">Registo</h1>

        <!-- Mensagens de erro globais -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-center">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Register" asp-controller="Account" method="post" class="p-4 border rounded shadow-sm bg-white">
            <!-- Nome -->
            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Digite o seu nome completo" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Digite o seu email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Digite a sua password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Confirmar Password -->
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirme a sua password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Número de Telefone -->
            <div class="mb-3">
                <label asp-for="Tele_n" class="form-label">Número de Telefone</label>
                <input asp-for="Tele_n" type="tel" class="form-control" placeholder="Digite o seu número de telefone" />
                <span asp-validation-for="Tele_n" class="text-danger"></span>
            </div>

            <!-- Data de Nascimento -->
            <div class="mb-3">
                <label asp-for="Data_n" class="form-label">Data de Nascimento</label>
                <input asp-for="Data_n" type="date" class="form-control" />
                <span asp-validation-for="Data_n" class="text-danger"></span>
            </div>

            <!-- Endereço -->
            <div class="mb-3">
                <label asp-for="Endereco" class="form-label">Morada</label>
                <input asp-for="Endereco" class="form-control" placeholder="Digite a sua morada" />
                <span asp-validation-for="Endereco" class="text-danger"></span>
            </div>

            <!-- Número da Morada -->
            <div class="mb-3">
                <label asp-for="Endereco_n" class="form-label">Número da Morada</label>
                <input asp-for="Endereco_n" class="form-control" placeholder="Número da morada" />
                <span asp-validation-for="Endereco_n" class="text-danger"></span>
            </div>

            <!-- Localidade -->
            <div class="mb-3">
                <label asp-for="Localidade" class="form-label">Localidade</label>
                <input asp-for="Localidade" class="form-control" placeholder="Digite a sua localidade" />
                <span asp-validation-for="Localidade" class="text-danger"></span>
            </div>

            <!-- País -->
            <div class="mb-3">
                <label asp-for="Pais" class="form-label">País</label>
                <select asp-for="Pais" class="form-select">
                    <option value="">Selecione um país</option>
                    @foreach (var pais in ViewBag.Paises as List<string>)
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
                <span asp-validation-for="Pais" class="text-danger"></span>
            </div>


            <!-- Botão de Submeter -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary w-100">Registar</button>
            </div>
        </form>
    </div>

    <!-- Espaço extra para evitar que o botão toque no footer -->
    <div style="margin-bottom: 100px;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model LEIUTAD.Models.Bibliotecarios

<h2 class="text-center">Editar Bibliotecário</h2>

<form asp-action="EditarBibliotecario" method="post" style="max-width: 800px; margin: auto;">
    <input type="hidden" asp-for="ID_Bib" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tele_n" class="form-label">Telefone</label>
        <input asp-for="Tele_n" class="form-control" />
        <span asp-validation-for="Tele_n" class="text-danger"></span>
    </div>

    <div class="text-center" style="margin-bottom: 50px;">
        <button type="submit" class="btn btn-primary">Guardar Alterações</button>
        <a asp-action="GerirUtilizadores" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

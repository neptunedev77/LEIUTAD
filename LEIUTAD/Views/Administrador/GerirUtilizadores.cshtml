@model List<LEIUTAD.Models.Administrador.UtilizadorViewModel>

@{
    ViewData["Title"] = "Gerir Utilizadores";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            height: 100vh;
            width: 250px;
            background-color: #343a40;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            padding-top: 20px;
        }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 30px;
                font-size: 1.5rem;
            }

            .sidebar a {
                display: block;
                color: #adb5bd;
                padding: 10px 20px;
                text-decoration: none;
                border-radius: 5px;
                margin-bottom: 5px;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #007bff;
                    color: #fff;
                }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .btn-action {
            padding: 8px;
            font-size: 0.9rem;
            margin-right: 5px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            width: 36px;
            height: 36px;
        }

            .btn-action i {
                font-size: 1.2rem;
            }

            .btn-action:hover {
                opacity: 0.8;
            }

        .search-bar {
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border-radius: 0.375rem 0 0 0.375rem;
                border-right: none;
            }

            .search-bar button {
                border-radius: 0 0.375rem 0.375rem 0;
            }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center">Painel do Administrador</h4>
        <a href="@Url.Action("Index", "Administrador")">Dashboard</a>
        <a href="#" class="active">Gerir Utilizadores</a>
    </div>

    <!-- Content -->
    <div class="content">
        <h1 class="mb-4">@ViewData["Title"]</h1>

        <!-- Barra de Pesquisa -->
        <div class="search-bar mb-3">
            <input type="text" id="searchInput" class="form-control" placeholder="Procurar utilizadores..." onkeyup="filterTable()">
            <button class="btn btn-primary">
                <i class="fas fa-search"></i>
            </button>
        </div>
        <div class="mb-3 text-end">
            <a asp-action="AdicionarAdministrador" class="btn btn-success">Adicionar Administrador</a>
        </div>


        <!-- Tabela de Utilizadores -->
        <table class="table table-bordered table-hover" id="utilizadoresTable">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Cargo</th>
                    <th>Ferramentas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                        <tr>
                            <td class="text-center">@user.ID</td>
                            <td><b>@user.Nome</b></td>
                            <td>@user.Cargo</td>
                                <td class="text-center">
                                    <!-- Botão de Visualizar -->
                                    <button type="button" class="btn btn-info btn-action" data-bs-toggle="modal"
                                            onclick="carregarDetalhesUtilizador(@user.ID, '@user.Cargo')" title="Visualizar">
                                        <i class="fas fa-eye"></i>
                                    </button>

                                    


                                    <!-- Botão de Bloqueio (somente para Leitores e Bibliotecários) -->
                                                        @if (user.Cargo != "Administrador")
                                                        {
                                            <!-- Botão de Editar -->
                                            <a href="@Url.Action("EditarUtilizador", "Administrador", new { id = user.ID, cargo = user.Cargo })"
                                               class="btn btn-warning btn-action" title="Editar">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-action bloqueio-btn @(user.IsBloqueado ? "btn-danger" : "btn-success")"
                                                    title="@(user.IsBloqueado ? "Desbloquear" : "Bloquear")"
                                                    onclick="toggleBloqueio(@user.ID, '@user.Cargo', @(user.IsBloqueado.ToString().ToLower()))">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                                        }
                                </td>

                        </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modal para Detalhes -->
    <div class="modal fade" id="detalhesModal" tabindex="-1" aria-labelledby="detalhesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="detalhesModalContent">
                <!-- Conteúdo será carregado dinamicamente -->
            </div>
        </div>
    </div>

    <script>
        // Filtrar Tabela
        function filterTable() {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            const table = document.getElementById('utilizadoresTable');
            const rows = table.getElementsByTagName('tr');

            for (let i = 1; i < rows.length; i++) {
                const cells = rows[i].getElementsByTagName('td');
                let match = false;

                for (let j = 0; j < cells.length; j++) {
                    if (cells[j] && cells[j].innerText.toLowerCase().indexOf(filter) > -1) {
                        match = true;
                        break;
                    }
                }

                rows[i].style.display = match ? '' : 'none';
            }
        }

        function carregarDetalhesUtilizador(id, tipo) {
            $.ajax({
                url: '/Administrador/DetalhesUtilizador',
                type: 'GET',
                data: { id: id, tipo: tipo },
                success: function (data) {
                    $('#detalhesModalContent').html(data);
                    const modal = new bootstrap.Modal(document.getElementById('detalhesModal'));
                    modal.show();
                },
                error: function () {
                    alert('Erro ao carregar os detalhes do utilizador.');
                }
            });
        }

        function toggleBloqueio(id, cargo, isBloqueado) {
            const novaAcao = isBloqueado === 'true' ? 'Desbloquear' : 'Bloquear';
            const confirmacao = confirm(`Tem certeza que deseja ${novaAcao} este utilizador?`);

            if (!confirmacao) {
                return;
            }

            $.ajax({
                url: '/Administrador/ToggleBloqueio',
                type: 'POST',
                data: { id: id, cargo: cargo },
                success: function (res) {
                    if (res.sucesso) {
                        // Atualizar o botão visualmente
                        const btn = $(`button[onclick="toggleBloqueio(${id}, '${cargo}', ${isBloqueado})"]`);
                        const isBloqueadoNovo = !JSON.parse(isBloqueado); // Alterna o estado de bloqueio

                        btn.toggleClass('btn-success btn-danger');
                        btn.attr('title', isBloqueadoNovo ? 'Desbloquear' : 'Bloquear');
                        btn.attr('onclick', `toggleBloqueio(${id}, '${cargo}', ${isBloqueadoNovo})`);
                    } else {
                        alert(res.mensagem || "Erro ao atualizar o estado de bloqueio.");
                    }
                },
                error: function () {
                    alert("Erro ao comunicar com o servidor. Tente novamente.");
                }
            });
        }

        function bloquearUtilizador(id, cargo) {
            const confirmacao = confirm(`Tem certeza que deseja bloquear este ${cargo.toLowerCase()}?`);

            if (!confirmacao) {
                return;
            }

            $.ajax({
                url: '/Administrador/BloquearUtilizador',
                type: 'POST',
                data: { id: id, cargo: cargo },
                success: function (res) {
                    if (res.sucesso) {
                        alert(`${cargo} bloqueado com sucesso.`);
                        location.reload(); // Atualiza a página para refletir o novo estado
                    } else {
                        alert(res.mensagem || "Erro ao bloquear o utilizador.");
                    }
                },
                error: function () {
                    alert("Erro ao comunicar com o servidor. Tente novamente.");
                }
            });
        }


    </script>
</body>
</html>

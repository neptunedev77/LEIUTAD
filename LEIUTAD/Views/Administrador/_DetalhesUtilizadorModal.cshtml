@model dynamic

<div class="modal-header">
    <h5 class="modal-title">Detalhes do Utilizador</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    @if (Model.Tipo == "Leitor")
    {
        <h6>Leitor</h6>
        <p><strong>Nome:</strong> @Model.Detalhes.Nome</p>
        <p><strong>Email:</strong> @Model.Detalhes.Email</p>
        <p><strong>Telefone:</strong> @Model.Detalhes.Tele_n</p>
        <p><strong>Endereço:</strong> @Model.Detalhes.Endereco, @Model.Detalhes.Endereco_n</p>
        <p><strong>Localidade:</strong> @Model.Detalhes.Localidade</p>
        <p><strong>País:</strong> @Model.Detalhes.Pais</p>
    }
    else if (Model.Tipo == "Bibliotecário")
    {
        <h6>Bibliotecário</h6>
        <p><strong>Nome:</strong> @Model.Detalhes.Nome</p>
        <p><strong>Email:</strong> @Model.Detalhes.Email</p>
        <p><strong>Telefone:</strong> @Model.Detalhes.Tele_n</p>
    }
    else if (Model.Tipo == "Administrador")
    {
        <h6>Administrador</h6>
        <p><strong>Nome:</strong> @Model.Detalhes.Nome</p>
        <p><strong>Email:</strong> @Model.Detalhes.Email</p>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
</div>

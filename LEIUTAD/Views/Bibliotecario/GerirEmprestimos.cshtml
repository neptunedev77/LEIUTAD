@model IEnumerable<dynamic>

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            height: 100vh;
            width: 250px;
            background-color: #343a40;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            padding-top: 20px;
        }

            .sidebar a {
                display: block;
                color: #adb5bd;
                padding: 10px 20px;
                margin: 5px 0;
                text-decoration: none;
                font-size: 1rem;
                border-radius: 5px;
                transition: all 0.3s;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #007bff;
                    color: #fff;
                }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 30px;
                font-size: 1.2rem;
                font-weight: bold;
            }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .table {
            margin-top: 20px;
        }

        .btn {
            font-size: 0.9rem;
        }

        .tools {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .search-bar {
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border-radius: 0.375rem 0 0 0.375rem;
                border-right: none;
            }

            .search-bar button {
                border-radius: 0 0.375rem 0.375rem 0;
            }

        .btn-history {
            margin-left: auto;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center">Painel do Bibliotecário</h4>
        <a href="@Url.Action("Index", "Bibliotecario")">Dashboard</a>
        <a href="@Url.Action("GerirLivros", "Bibliotecario")">Gerir Livros</a>
        <a href="" class="active">Empréstimos</a>
    </div>

    <!-- Content -->
    <div class="content">
        <h1 class="mb-4">Gerir Empréstimos</h1>

        <!-- Exibição de mensagens de sucesso/erro -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div id="alertaSucesso" class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div id="alertaErro" class="alert alert-danger">
                @TempData["MensagemErro"]
            </div>
        }

        <!-- Ferramentas -->
        <div class="tools">
            <!-- Barra de Pesquisa -->
            <div class="search-bar">
                <input type="text" id="searchInput" class="form-control" placeholder="Procurar empréstimos..." onkeyup="filterTable()">
                <button class="btn btn-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>

            <div class="d-flex justify-content-end mb-3">
                <a href="@Url.Action("HistoricoEmprestimos", "Bibliotecario")" class="btn btn-secondary">
                    Ver Histórico
                </a>
            </div>


        </div>

        <!-- Tabela para exibir os empréstimos -->
        <table class="table table-bordered table-hover" id="emprestimosTable">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID Empréstimo</th>
                    <th>ID Leitor</th>
                    <th>Nome do Leitor</th>
                    <th>Nº de Livros</th>
                    <th>Data Limite de Devolução</th>
                    <th>Estado</th>
                    <th>Ferramentas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emprestimo in Model)
                {
                    <tr>
                        <td class="text-center">@emprestimo.ID_Emp</td>
                        <td class="text-center">@emprestimo.ID_Leitor</td>
                        <td>@emprestimo.NomeLeitor</td>
                        <td class="text-center">@emprestimo.NumeroLivros</td>
                        <td class="text-center">@emprestimo.Data_Dev.ToString("dd/MM/yyyy")</td>
                        <td class="text-center" style="color: @(emprestimo.Estado == "Por Devolver" ? "red" : "green");">
                            <b>@emprestimo.Estado</b>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-info btn-sm" title="Detalhes" data-bs-toggle="modal" data-bs-target="#detalhesModal" onclick="carregarDetalhesEmprestimo(@emprestimo.ID_Emp)">
                                <i class="fa fa-eye"></i>
                            </button>

                            <a href="@Url.Action("EnviarNotificacao", "Bibliotecario", new { id = emprestimo.ID_Emp })" class="btn btn-warning btn-sm" title="Notificar">
                                <i class="fa fa-envelope"></i>
                            </a>
                            <a href="@Url.Action("HistoricoEmprestimosLeitor", "Bibliotecario", new { idLeitor = emprestimo.ID_Leitor })"
                               class="btn btn-secondary btn-sm"
                               title="Histórico do Leitor">
                                <i class="fa fa-history"></i>
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="modal fade" id="detalhesModal" tabindex="-1" aria-labelledby="detalhesModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content" id="detalhesModalContent">
                    <!-- O conteúdo será carregado dinamicamente -->
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Script para filtrar tabela -->
    <script>
        function filterTable() {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            const table = document.getElementById('emprestimosTable');
            const rows = table.getElementsByTagName('tr');

            for (let i = 1; i < rows.length; i++) {
                const cells = rows[i].getElementsByTagName('td');
                let match = false;

                for (let j = 0; j < cells.length; j++) {
                    if (cells[j] && cells[j].innerText.toLowerCase().indexOf(filter) > -1) {
                        match = true;
                        break;
                    }
                }

                rows[i].style.display = match ? '' : 'none';
            }
        }
    </script>
    <script>
        function carregarDetalhesEmprestimo(id) {
            $.ajax({
                url: '/Bibliotecario/DetalhesEmprestimo',
                type: 'GET',
                data: { id: id },
                success: function (data) {
                    $('#detalhesModalContent').html(data); // Carrega o conteúdo no modal
                    $('#detalhesModal').modal('show'); // Abre o modal
                },
                error: function () {
                    alert('Erro ao carregar os detalhes do empréstimo.');
                }
            });
        }
    </script>
</body>
</html>

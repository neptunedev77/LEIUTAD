@model List<LEIUTAD.Models.Livros>

@{
    ViewData["Title"] = "Painel do Bibliotecário";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Link -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            height: 100vh;
            width: 250px;
            background-color: #343a40;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            padding-top: 20px;
        }

            .sidebar a {
                display: block;
                color: #adb5bd;
                padding: 10px 20px;
                margin: 5px 0;
                text-decoration: none;
                font-size: 1rem;
                border-radius: 5px;
                transition: all 0.3s;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #007bff;
                    color: #fff;
                }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 30px;
                font-size: 1.2rem;
                font-weight: bold;
            }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .table img {
            width: 50px; /* Reduz o tamanho da imagem */
            height: auto;
            border-radius: 4px;
        }

        .btn-action {
            padding: 5px;
            margin-right: 5px;
            color: #000; /* Ícones em preto */
            background-color: transparent;
            border: none;
        }

            .btn-action:hover {
                color: #007bff; /* Muda para azul ao passar o rato */
            }

            .btn-action i {
                font-size: 1.2rem;
            }

        .tools {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .search-bar {
            display: flex;
            align-items: center;
        }

            .search-bar input {
                border-radius: 0.375rem 0 0 0.375rem;
                border-right: none;
            }

            .search-bar button {
                border-radius: 0 0.375rem 0.375rem 0;
            }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center">Painel do Bibliotecário</h4>
        <a href="@Url.Action("Index", "Bibliotecario")">Dashboard</a>
        <a href="#" class="active">Gerir Livros</a>
        <a href="@Url.Action("GerirEmprestimos", "Bibliotecario")">Empréstimos</a>
    </div>

    <!-- Content -->
    <div class="content">
        <h1 class="mb-4">Gerir Livros</h1>
        <!-- Exibição de mensagens de sucesso/erro -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div id="alertaSucesso" class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div id="alertaErro" class="alert alert-danger">
                @TempData["MensagemErro"]
            </div>
        }

        <!-- Ferramentas -->
        <div class="tools">
            <!-- Botão de Adicionar Livro -->
            <a href="@Url.Action("AdicionarLivro", "Bibliotecario")" class="btn btn-success">
                <i class="fas fa-plus"></i> Adicionar Livro
            </a>

            <!-- Barra de Pesquisa -->
            <div class="search-bar">
                <input type="text" id="searchInput" class="form-control" placeholder="Procurar livro..." onkeyup="filterTable()">
                <button class="btn btn-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>

        <!-- Tabela para exibir os livros -->
        <table class="table table-bordered table-hover" id="livrosTable">
            <thead class="table-dark text-center">
                <tr>
                    <th>ISBN</th>
                    <th>Título</th>
                    <th>Imagem</th>
                    <th>Descrição</th>
                    <th>Ferramentas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var livro in Model)
                {
                    <tr>
                        <td class="text-center">@livro.ISBN</td>
                        <td><b>@livro.Titulo</b></td>
                        <td class="text-center">
                            <img src="~/images/livros/@livro.Imagem" alt="@livro.Titulo" />
                        </td>
                        <td>@livro.Sinopse</td>
                        <td class="text-center">
                            <!-- Botões de ferramentas -->
                            <a style="text-decoration: none;" asp-action="EditarLivro" asp-route-id="@livro.ISBN" class="btn-action" title="Editar">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <button type="button" class="btn-action" title="Visualizar" data-bs-toggle="modal" data-bs-target="#detalhesModal"
                                    onclick="carregarDetalhesLivro('@livro.ISBN')">
                                <i class="fas fa-eye"></i>
                            </button>

                            <form asp-action="EliminarLivro" asp-controller="Bibliotecario" method="post" style="display:inline;">
                                <input type="hidden" name="isbn" value="@livro.ISBN" />
                                <button type="submit" class="btn-action text-danger" title="Remover" onclick="return confirm('Tem a certeza que quer eliminar este livro?')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="detalhesModal" tabindex="-1" aria-labelledby="detalhesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="detalhesModalContent">
                <!-- O conteúdo será carregado via AJAX -->
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Script para filtrar tabela -->
    <script>
        function filterTable() {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            const table = document.getElementById('livrosTable');
            const rows = table.getElementsByTagName('tr');

            for (let i = 1; i < rows.length; i++) {
                const cells = rows[i].getElementsByTagName('td');
                let match = false;

                for (let j = 0; j < cells.length; j++) {
                    if (cells[j] && cells[j].innerText.toLowerCase().indexOf(filter) > -1) {
                        match = true;
                        break;
                    }
                }

                rows[i].style.display = match ? '' : 'none';
            }
        }
    </script>
    <!-- Script para esconder os alertas automaticamente após 2 segundos -->
    <script>
        
        setTimeout(() => {
            const alertaSucesso = document.getElementById("alertaSucesso");
            const alertaErro = document.getElementById("alertaErro");

            if (alertaSucesso) {
                alertaSucesso.style.transition = "opacity 0.5s ease-out";
                alertaSucesso.style.opacity = "0";

                setTimeout(() => alertaSucesso.remove(), 500); // Remove do DOM após a transição
            }

            if (alertaErro) {
                alertaErro.style.transition = "opacity 0.5s ease-out";
                alertaErro.style.opacity = "0";

                setTimeout(() => alertaErro.remove(), 500);
            }
        }, 2000); // Espera 2 segundos antes de ocultar
    </script>
    <!-- Carregar detalhes do Livro no ícone -->
    <script>
        function carregarDetalhesLivro(isbn) {
            $.ajax({
                url: '@Url.Action("DetalhesLivro", "Bibliotecario")',
                type: 'GET',
                data: { id: isbn },
                success: function (data) {
                    $('#detalhesModalContent').html(data); // Carrega o conteúdo do modal
                },
                error: function () {
                    alert('Erro ao carregar os detalhes do livro.');
                }
            });
        }
    </script>

</body>
</html>

@model IEnumerable<LEIUTAD.Models.Emprestimo>

@{
    ViewData["Title"] = "Histórico de Empréstimos do Leitor";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<h2 class="text-center mb-4">Histórico de Empréstimos - @ViewBag.LeitorNome</h2>

<!-- Tabela de Histórico -->
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID Empréstimo</th>
            <th>Data de Requisição</th>
            <th>Data de Devolução</th>
            <th>Estado</th>
            <th>Número de Livros</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emprestimo in Model)
        {
            <tr>
                <td>@emprestimo.ID_Emp</td>
                <td>@emprestimo.Data_Req.ToString("dd/MM/yyyy")</td>
                <td>@emprestimo.Data_Dev.ToString("dd/MM/yyyy")</td>
                <td style="color: @(emprestimo.Estado == "Por Devolver" ? "red" : "green");">
                    @emprestimo.Estado
                </td>
                <td>@(emprestimo.Emprestimo_Livros?.Count() ?? 0)</td>
                <td>
                    <button type="button" class="btn btn-info btn-sm" title="Detalhes" data-bs-toggle="modal" data-bs-target="#detalhesModal" onclick="carregarDetalhesEmprestimo(@emprestimo.ID_Emp)">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>

<!-- Modal para exibir os detalhes do empréstimo -->
<div class="modal fade" id="detalhesModal" tabindex="-1" aria-labelledby="detalhesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="detalhesModalContent">
            <!-- O conteúdo será carregado dinamicamente -->
        </div>
    </div>
</div>

<a href="@Url.Action("GerirEmprestimos", "Bibliotecario")" class="btn btn-primary mt-3">
    Voltar
</a>

<script>
    function carregarDetalhesEmprestimo(id) {
        $.ajax({
            url: '/Bibliotecario/DetalhesEmprestimo',
            type: 'GET',
            data: { id: id },
            success: function (data) {
                $('#detalhesModalContent').html(data);
                $('#detalhesModal').modal('show');
            },
            error: function () {
                alert('Erro ao carregar os detalhes do empréstimo.');
            }
        });
    }
</script>

@model List<LEIUTAD.ViewModels.LivrosPorGeneroViewModel>

@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Landing Page - LEIUTAD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Descubra Livros por Género</h1>

        @foreach (var genero in Model)
        {
            <div class="mb-5">
                <h2 class="mb-3">Livros de @genero.Genero</h2>
                <div id="@($"{genero.Genero.Replace(" ", "")}Carousel")" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @if (genero.Livros.Any())
                        {
                            int index = 0;
                            @foreach (var livro in genero.Livros)
                            {
                                <div class="carousel-item @(index == 0 ? "active" : "")">
                                    <div class="d-flex flex-column align-items-center text-center">
                                        <h5>@livro.Titulo</h5>
                                        <p>Autor: @livro.Autor.Autor_Nome</p>
                                        <p>Preço: @livro.Preco.ToString("F2") €</p>
                                    </div>
                                </div>
                                index++;
                            }
                        }
                        else
                        {
                            <div class="carousel-item active">
                                <div class="d-flex justify-content-center">
                                    <p>Sem livros disponíveis neste género.</p>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botões de controlo do carousel -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#@($"{genero.Genero.Replace(" ", "")}Carousel")" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#@($"{genero.Genero.Replace(" ", "")}Carousel")" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                </div>
            </div>
        }

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model LEIUTAD.Models.Livros

@{
    ViewData["Title"] = "Detalhes do Livro";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Arial', sans-serif;
        }

        .details-container {
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            max-width: 900px;
            padding: 20px;
        }

        .details-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .details-header h1 {
                font-size: 2.2rem;
                color: #343a40;
                font-weight: bold;
            }

        .details-content {
            display: flex;
            gap: 20px;
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .details-image {
            flex: 1;
            max-width: 300px;
        }

            .details-image img {
                width: 100%;
                height: auto;
                border-radius: 10px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .details-info {
            flex: 2;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .details-info p {
                font-size: 1rem;
                color: #495057;
                margin-bottom: 10px;
            }

            .details-info span {
                font-weight: bold;
                color: #212529;
            }

        .details-buttons {
            text-align: center;
            margin-top: 30px;
        }

            .details-buttons a,
            .details-buttons button {
                margin: 10px 5px;
                padding: 10px 20px;
                font-size: 1rem;
                border-radius: 5px;
                font-weight: bold;
            }

        .btn-back {
            background-color: #6c757d;
            color: #ffffff;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                background-color: #5a6268;
            }

        .btn-request {
            background-color: #007bff;
            color: #ffffff;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-request:hover {
                background-color: #0056b3;
            }

        .btn-login {
            color: #fff;
            background-color: #28a745;
            border: none;
            border-radius: 5px;
            padding: 5px 10px;
            margin-left: 5px;
            text-decoration: none;
            font-weight: bold;
            transition: background-color 0.3s;
        }

            .btn-login:hover {
                background-color: #218838;
            }

        .footer-space {
            margin-bottom: 40px;
        }
    </style>
</head>
<body>
    <div class="container details-container">
        <!-- Título do livro -->
        <div class="details-header">
            <h1>@Model.Titulo</h1>
        </div>

        <!-- Conteúdo do livro -->
        <div class="details-content">
            <!-- Imagem -->
            <div class="details-image">
                <img src="~/images/livros/@Model.Imagem" alt="@Model.Titulo">
            </div>

            <!-- Informações -->
            <div class="details-info">
                <p><span>Sinopse:</span> @Model.Sinopse</p>
                <p><span>Autor:</span> @Model.Autor.Autor_Nome</p>
                <p><span>Género:</span> @Model.Genero.Genero</p>
                <p><span>Estado:</span> Ainda nao adicionei o campo do estado (relativo aos emprestimos)</p>
            </div>
        </div>

        <!-- Botões -->
        <div class="details-buttons footer-space">
            <a href="@(!string.IsNullOrEmpty(ViewBag.ReturnUrl) ? ViewBag.ReturnUrl : Url.Action("Index", "Livros"))" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
            <form asp-action="AdicionarAoCarrinho" asp-controller="Leitors" method="post" class="d-inline">
                <input type="hidden" name="isbn" value="@Model.ISBN" />
                <button class="btn btn-request" data-isbn="@Model.ISBN">
                    <i class="fas fa-shopping-cart"></i> Requisitar
                </button>
                <div class="mensagemErro mt-2"></div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll(".btn-request").forEach((button) => {
            button.addEventListener("click", (e) => {
                e.preventDefault();

                const isbn = button.dataset.isbn;
                fetch("/Leitor/AdicionarAoCarrinho", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ isbn }),
                })
                    .then((response) => response.json())
                    .then((data) => {
                        // Remover mensagens anteriores
                        const existingAlert = button.nextElementSibling;
                        if (existingAlert && existingAlert.classList.contains("alert")) {
                            existingAlert.remove();
                        }

                        // Criar nova mensagem
                        const alertDiv = document.createElement("div");
                        alertDiv.className = data.sucesso ? "alert alert-success mt-2" : "alert alert-danger mt-2";
                        alertDiv.innerHTML = data.mensagem;

                        // Adicionar botão de "Ver Carrinho" se o link existir
                        if (data.linkVerCarrinho) {
                            const verCarrinhoBtn = document.createElement("a");
                            verCarrinhoBtn.href = data.linkVerCarrinho;
                            verCarrinhoBtn.textContent = " Ver Carrinho";
                            verCarrinhoBtn.className = "btn btn-primary ms-2";
                            alertDiv.appendChild(verCarrinhoBtn);
                        }

                        // Adicionar link de login se for necessário
                        if (data.linkLogin) {
                            const loginLink = document.createElement("a");
                            loginLink.href = data.linkLogin;
                            loginLink.textContent = " Fazer login";
                            loginLink.className = "ms-2";
                            alertDiv.appendChild(loginLink);
                        }

                        // Inserir a mensagem abaixo do botão requisitar
                        button.parentElement.appendChild(alertDiv);

                        // Remover a mensagem após 5 segundos
                        setTimeout(() => alertDiv.remove(), 5000);
                    })
                    .catch((error) => {
                        console.error("Erro:", error);
                    });
            });
        });

    </script>

</body>
</html>

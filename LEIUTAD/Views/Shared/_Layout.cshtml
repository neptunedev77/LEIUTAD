@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LEIUTAD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LEIUTAD.styles.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
        }

        .navbar {
            background-color: #f8f9fa;
        }

        .navbar-brand img {
            height: 40px;
        }

        .btn-outline-success {
            border-color: #28a745;
            color: #28a745;
        }

            .btn-outline-success:hover {
                background-color: #28a745;
                color: #fff;
            }

        main {
            flex: 1;
            padding-bottom: 30px; /* Separar footer */
        }

        .footer {
            background-color: #f8f9fa;
            text-align: center;
            border-top: 10px #ddd;
        }

        .btn-cart {
            display: flex;
            align-items: center;
            gap: 5px;
            background-color: #007bff;
            color: white;
            border: none;
        }

            .btn-cart:hover {
                background-color: #0056b3;
                color: white;
            }
    </style>
</head>
<body style="background-color: #fcf6eb;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Livros" asp-action="Index">
                    <img src="~/images/logo.png" alt="LEIUTAD" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Bibliotecario")
                        {
                            <!-- Alternar entre "Página Inicial" e "Painel do Bibliotecário" -->
                            @if (ViewData["Title"] == "Página Inicial")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Bibliotecario" asp-action="Index">Painel do Bibliotecário</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Livros" asp-action="Index">Página Inicial</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex ms-auto">
                        @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Leitor")
                        {
                            <a href="@Url.Action("VerCarrinho", "Leitors")" class="btn btn-primary me-3" style="text-decoration: none; color: white;">
                                <i class="fa fa-shopping-cart"></i> Carrinho
                                <span class="badge bg-danger">
                                    @(HttpContextAccessor.HttpContext.Session.GetObjectFromJson<List<string>>("Carrinho")?.Count ?? 0)
                                </span>
                            </a>

                        }


                        @if (HttpContextAccessor.HttpContext.Session.GetString("UserName") != null)
                        {
                            <!-- Utilizador autenticado -->
                            <form asp-area="" asp-controller="Pesquisa" asp-action="Index" method="get" class="d-flex me-3">
                                <input class="form-control me-2" type="search" name="query" placeholder="Pesquisar livros..." aria-label="Pesquisar">
                                <button class="btn btn-outline-success" type="submit">Pesquisar</button>
                            </form>
                            <span class="navbar-text me-3">Bem-vindo, @HttpContextAccessor.HttpContext.Session.GetString("UserName")</span>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger">Logout</button>
                            </form>
                        }
                        else
                        {
                            <!-- Utilizador não autenticado -->
                            <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary me-2" style="background-color: #7d2f22; border-color: #7d2f22;">Login</a>
                            <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-secondary">Registo</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer text-center @(HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Bibliotecario" ? "text-white bg-dark" : "text-muted")">
        <div class="container">
            &copy; 2024 - LEIUTAD &bull; Todos os direitos reservados.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
